# ══════════════════════════════════════════════════════════════════════════════
#  R-TeleSwiftBot · Configuration (copy to config.env and fill in your values)
# ══════════════════════════════════════════════════════════════════════════════
#
#  USAGE
#  ─────
#  Local / Docker  : cp sample_config.env config.env  →  edit config.env
#  PaaS platforms  : Paste each key=value directly into the platform's
#                    "Environment Variables" / "Secrets" dashboard.
#  NEVER commit config.env or any file with real secrets to version control.
#
#  QUICK START (minimum required)
#  ──────────────────────────────
#  1. Set API_ID, API_HASH (from https://my.telegram.org/apps)
#  2. Set BOT_TOKEN (from @BotFather on Telegram)
#  3. Set ADMIN_ID (your Telegram user ID — find it via @userinfobot)
#  4. Set PUBLIC_URL (the public HTTPS URL of your server/PaaS app)
#  5. Run:  python bot.py
#
# ══════════════════════════════════════════════════════════════════════════════
#  REQUIRED — the bot won't start without these three values
# ══════════════════════════════════════════════════════════════════════════════

# Telegram Application credentials from https://my.telegram.org/apps
# API_ID is a numeric integer (e.g. 12345678)
API_ID=your_numeric_api_id

# API_HASH is a 32-character hex string
API_HASH=your_api_hash_string

# Bot token obtained from @BotFather on Telegram
# Format: 123456789:ABCdef...
BOT_TOKEN=your_bot_token

# ══════════════════════════════════════════════════════════════════════════════
#  ADMINISTRATOR  (strongly recommended)
# ══════════════════════════════════════════════════════════════════════════════

# Your Telegram user ID (numeric).
# Grants access to /admin, /ban, /unban, /admin_cancel_all,
# and the /rauthorize restricted-content login flow.
# Find your ID with @userinfobot on Telegram.
# Keep this value SECRET — never commit it to source control.
# ADMIN_ID=123456789
ADMIN_ID=your_telegram_user_id

# ══════════════════════════════════════════════════════════════════════════════
#  PUBLIC URL  (required for file streaming links)
# ══════════════════════════════════════════════════════════════════════════════

# Public HTTPS base URL of this bot's server.
# Used for /filestream temporary stream/download links.
# On PaaS (Railway, Render, Fly.io): set to the platform-assigned HTTPS URL.
# On VPS: set to https://yourdomain.com (with a reverse proxy like nginx/caddy).
# On localhost (dev): set to http://127.0.0.1:8080 (links won't work externally).
# Example: PUBLIC_URL=https://your-app.up.railway.app
PUBLIC_URL=https://your-public-url.example.com

# Override the base URL if your file server lives at a different address.
# Defaults to PUBLIC_URL when unset.
# FILE_URL_BASE=https://files.your-domain.com

# ══════════════════════════════════════════════════════════════════════════════
#  COOKIE ENCRYPTION  (strongly recommended)
# ══════════════════════════════════════════════════════════════════════════════

# Long random secret used to encrypt browser cookies stored on disk.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# If omitted, the bot auto-creates a key at WORK_DIR/.cookie-encryption-key.
# WARNING: if this key changes, all stored cookies become unreadable.
# COOKIE_ENCRYPTION_KEY=replace_with_a_long_random_secret_min_32_chars

# ══════════════════════════════════════════════════════════════════════════════
#  WORKER CONCURRENCY & QUEUE
# ══════════════════════════════════════════════════════════════════════════════

# Number of simultaneous download workers.
# 2 is a safe default; increase to 4-8 on servers with good CPU and bandwidth.
WORKERS=2

# Maximum number of jobs allowed in the queue before new requests are rejected.
# Reduce to 8-16 for public bots to prevent abuse.
MAX_QUEUE_SIZE=32

# ══════════════════════════════════════════════════════════════════════════════
#  CACHE  (optional — Redis)
# ══════════════════════════════════════════════════════════════════════════════

# Set to false to use only in-process memory caching (single instance only).
# Set to true to use Redis for shared Telegram file-ID caching across processes.
# The bot falls back to memory cache automatically if Redis is unavailable.
ENABLE_REDIS=false

# Redis connection URL. Only used when ENABLE_REDIS=true.
REDIS_URL=redis://localhost:6379/0

# How long (in seconds) Telegram file-ID cache entries remain valid.
# Default: 86400 (24 hours). Minimum: 60.
CACHE_TTL=86400

# ══════════════════════════════════════════════════════════════════════════════
#  METADATA STORE  (optional — MongoDB)
# ══════════════════════════════════════════════════════════════════════════════

# MongoDB connection string for shared archive index, saved-file search,
# statistics, and user bans.
# Leave blank to use the local SQLite fallback (good for single-instance bots).
# Example: MONGODB_URL=mongodb+srv://user:pass@cluster.mongodb.net/
MONGODB_URL=

# MongoDB database name (default: ytdlbot)
MONGODB_DATABASE=ytdlbot

# ══════════════════════════════════════════════════════════════════════════════
#  WORKING DIRECTORY & FILE LIMITS
# ══════════════════════════════════════════════════════════════════════════════

# Directory where temporary download files and session data are stored.
# On PaaS: must be a persistent volume mount (e.g. /data or /mnt/ytdl).
# On VPS/local: any writable directory (e.g. /tmp/ytdlbot or ./data).
WORK_DIR=tmp/ytdlbot

# SQLite database path for permanent file-store deep links.
# Keep on a persistent disk on PaaS platforms.
FILE_STORE_DB=tmp/ytdlbot/file-store.sqlite3

# Maximum file size (in MB) the bot will upload to Telegram.
# Telegram's hard limit for bots is 2000 MB.
# For standard Bot API without local server: practical limit is ~2000 MB.
MAX_UPLOAD_MB=2000

# Maximum file size (in MB) for a single download (yt-dlp / mirror / torrent).
# Defaults to MAX_UPLOAD_MB when omitted.
# Set lower (e.g. 500) on servers with limited disk space.
MAX_DOWNLOAD_MB=2000

# Maximum number of Telegram messages fetched by /save or a Telegram-link
# /mirror in a single request. Increase with caution on public bots.
RESTRICTED_MAX_MESSAGES=20

# ══════════════════════════════════════════════════════════════════════════════
#  FILE STREAMING SERVER
# ══════════════════════════════════════════════════════════════════════════════

# Host and port for the file-link HTTP streaming server.
# On single-port PaaS hosts: leave FILE_URL_PORT unset — it defaults to PORT.
# On VPS with multiple ports: set FILE_URL_PORT=8000 (or another free port).
FILE_URL_HOST=0.0.0.0
# FILE_URL_PORT=8000

# How long (in seconds) stream/download links remain valid.
# Maximum is 10800 (3 hours — hard-capped for user privacy).
# Minimum is 60 seconds.
FILE_URL_TTL=10800

# Maximum simultaneous Telegram file-stream connections.
# Reduce on low-memory hosts; increase on dedicated servers.
FILE_STREAM_CONCURRENCY=8

# ══════════════════════════════════════════════════════════════════════════════
#  HEALTH PROBE SERVER
# ══════════════════════════════════════════════════════════════════════════════

# Host and port for /healthz (liveness) and /readyz (readiness) HTTP endpoints.
# On single-port PaaS hosts: leave HEALTH_PORT unset — it defaults to PORT.
# On VPS: set HEALTH_PORT=8080 (or another free port).
HEALTH_HOST=0.0.0.0
# HEALTH_PORT=8080

# PORT is the primary listen port on PaaS platforms (Railway, Render, Fly.io).
# When set, both HEALTH_PORT and FILE_URL_PORT default to this value.
# PORT=8080

# ══════════════════════════════════════════════════════════════════════════════
#  ARCHIVE CHANNEL  (optional — required for /store and /myfiles)
# ══════════════════════════════════════════════════════════════════════════════

# Numeric ID of a Telegram channel where every downloaded file is archived.
# Leave blank to disable automatic archive storage and /store functionality.
# The bot MUST be an admin of this channel with "Post messages" permission.
# The bot MUST also have "Delete messages" permission for deduplication.
# To get channel ID: forward a message from the channel to @userinfobot.
# Example: BIN_CHANNEL_ID=-1001234567890
BIN_CHANNEL_ID=

# ══════════════════════════════════════════════════════════════════════════════
#  VOICE CHAT ASSISTANT  (optional — required for /vplay)
# ══════════════════════════════════════════════════════════════════════════════

# Numeric Telegram chat/group ID where the voice-chat assistant operates.
# Required for /vplay commands sent from private chats.
# Example: VC_CHAT_ID=-1001234567890
VC_CHAT_ID=

# Pyrogram session string for the voice-chat user account (NOT a bot account).
# Generate with:  python generate_vc_session.py
# Alternatively run vc_phone_login.py once on the host for a local session file.
# Keep this value SECRET — it gives full Telegram account access.
# VC_SESSION_STRING=your_pyrogram_session_string_here

# ══════════════════════════════════════════════════════════════════════════════
#  YOUTUBE PO TOKEN PROVIDER  (optional — advanced, bypasses rate limits)
# ══════════════════════════════════════════════════════════════════════════════

# Base URL of a bgutil-ytdlp-pot-provider instance.
# Only needed if your server IP is heavily rate-limited by YouTube.
# Leave blank if you upload cookies via /cookies instead.
# Setup: https://github.com/Brainicism/bgutil-ytdlp-pot-provider
# Example: POT_PROVIDER_URL=http://localhost:4416
# POT_PROVIDER_URL=http://localhost:4416

# ══════════════════════════════════════════════════════════════════════════════
#  RATE LIMITING  (optional — bot.py enhanced entry point only)
# ══════════════════════════════════════════════════════════════════════════════

# Maximum number of downloads a single user can submit per hour.
# Set to 0 to disable rate limiting (not recommended for public bots).
# Default: 10 downloads per user per hour.
# USER_RATE_LIMIT_PER_HOUR=10

# Maximum number of searches a single user can run per minute.
# Default: 5 searches per user per minute.
# USER_SEARCH_RATE_LIMIT_PER_MINUTE=5

# ══════════════════════════════════════════════════════════════════════════════
#  SYSTEM DEPENDENCY OVERRIDES  (advanced)
# ══════════════════════════════════════════════════════════════════════════════

# Paths to system binaries. Leave blank to auto-detect via PATH.
# Override only if the tools are in non-standard locations.
# FFMPEG_PATH=/usr/bin/ffmpeg
# ARIA2C_PATH=/usr/bin/aria2c
# BUN_PATH=/root/.bun/bin/bun
# DENO_PATH=/usr/local/bin/deno

# ══════════════════════════════════════════════════════════════════════════════
#  LOGGING  (optional)
# ══════════════════════════════════════════════════════════════════════════════

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Use DEBUG for troubleshooting; INFO for normal operation.
LOG_LEVEL=INFO
